<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ShogiBoard.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:GameViewModel"
             x:Class="ShogiBoard.Views.Parts.EngineCommunicator">
        <StackPanel>
            <TextBlock
                Margin="4"
                FontSize="16"
                HorizontalAlignment="Center"
                Text="{Binding Response}"
            ></TextBlock>
            <Button HorizontalAlignment="Center" Command="{Binding StartEngineCommand}">Start</Button>
            <TextBox Text="{Binding Message}"/>
            <Button HorizontalAlignment="Center" Command="{Binding SendMessageCommand}">SendMessage</Button>
            <Button HorizontalAlignment="Center" Command="{Binding QuitEngineCommand}">Quit</Button>
        </StackPanel>
</UserControl>
