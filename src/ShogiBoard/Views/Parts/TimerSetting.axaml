<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ShogiBoard.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:SettingViewModel"
             x:Class="ShogiBoard.Views.Parts.TimerSetting">
            <StackPanel Orientation="Horizontal" Spacing="4">
						  <StackPanel>
							  <TextBlock Text="Min" FontSize="12"/>
								<ComboBox
									ItemsSource="{Binding TimeMinutes}"
									SelectedValue="{Binding TimerStore.TimeSetting.TimeControlMin}"
									Height="24" MinHeight="0" Width="80" FontSize="12"
									SelectedIndex="0" MaxDropDownHeight="100"
								>
									<ComboBox.ItemTemplate>
											<DataTemplate>
													<TextBlock Text="{Binding}" />
											</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
						  </StackPanel>
						  <StackPanel>
							  <TextBlock Text="Byoyomi" FontSize="12"/>
								<ComboBox
									ItemsSource="{Binding Byoyomi}"
									SelectedValue="{Binding TimerStore.TimeSetting.ByoyomiSec}"
									Height="24" MinHeight="0" Width="80" FontSize="12"
									SelectedIndex="0" MaxDropDownHeight="100"
								>
									<ComboBox.ItemTemplate>
											<DataTemplate>
													<TextBlock Text="{Binding}" />
											</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
						  </StackPanel>
            </StackPanel>
</UserControl>
