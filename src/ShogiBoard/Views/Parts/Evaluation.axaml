                    <lvc:XamlAxis
                        TextSize="12"
                        SeparatorsPaint="{lvc:SolidColorPaint
                            Color={StaticResource gray},
                            StrokeWidth=1,
                            PathEffect={lvc:Dashed Array='3,3'}}"
                        SubseparatorsPaint="{lvc:SolidColorPaint
