                            Color={StaticResource gray},
                            StrokeWidth=1.5}"
                        SubticksPaint="{lvc:SolidColorPaint
                            Color={StaticResource gray},
                            StrokeWidth=1}"/>
                </lvc:CartesianChart.XAxes>

