<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ShogiBoard.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             Width="480"
             x:DataType="vm:GameViewModel"
             x:Class="ShogiBoard.Views.Parts.UserOperation">
        <StackPanel>
            <Grid
                ColumnDefinitions="Auto, Auto, Auto" RowDefinitions="Auto, Auto, Auto"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                RowSpacing="8" ColumnSpacing="4"
            >
                <Button Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Click="SelectEngine">Select Engine</Button>
                <Button Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Command="{Binding StartEngineCommand}">Start Engine</Button>
                <Button Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" Command="{Binding QuitEngineCommand}">Quit Engine</Button>
                <Button Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" Command="{Binding NewGameCommand}">New Game</Button>
                <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Command="{Binding GameEndCommand}">Game End</Button>
                <Button Grid.Row="1" Grid.Column="2" HorizontalAlignment="Left" Command="{Binding InitializeBoardCommand}">Initialize Board</Button>
                <StackPanel Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left">
                    <TextBlock Text="Byoyomi"/>
                    <NumericUpDown Value="{Binding TimeSetting.ByoyomiSec}" Minimum="0" Maximum="60" FormatString="0"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left">
                    <TextBlock Text="TimeControl"/>
                    <NumericUpDown Value="{Binding TimeSetting.TimeControlMin}" Minimum="0" Maximum="60" FormatString="0"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="4" HorizontalAlignment="Left">
                    <Grid
                        ColumnDefinitions="Auto, Auto, Auto, Auto" RowDefinitions="Auto, Auto, Auto, Auto"
                        ColumnSpacing="4"
                    >
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Black"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Min: "/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BlackTimeLeft.TimeControlMin}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Sec: "/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BlackTimeLeft.TimeControlSec}"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Byoyomi: "/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BlackTimeLeft.ByoyomiSec}"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="White"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Min: "/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding WhiteTimeLeft.TimeControlMin}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Sec: "/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding WhiteTimeLeft.TimeControlSec}"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Byoyomi: "/>
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding WhiteTimeLeft.ByoyomiSec}"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </StackPanel>
</UserControl>
