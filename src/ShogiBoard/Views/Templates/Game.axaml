<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:parts="using:ShogiBoard.Views.Parts"
             xmlns:vm="using:ShogiBoard.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:GameViewModel"
             x:Class="ShogiBoard.Views.Templates.Game">
            <StackPanel Margin="60, 0, 60, 0">
              <parts:UserOperation />
              <Grid
                ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto"
                RowSpacing="4" ColumnSpacing="4"
              >
                <parts:PieceStandView
                  Pieces="{Binding TopPieceStand}"
                  HorizontalAlignment="Left" VerticalAlignment="Center"
                  Grid.Row="0" Grid.Column="0"
                />
                <parts:TimerViewer
                  Timer="{Binding TopGameTime}"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Grid.Row="0" Grid.Column="2"
                />
              </Grid>
              <parts:Board />
              <Grid>
                <parts:PieceStandView
                  Pieces="{Binding BottomPieceStand}"
                  HorizontalAlignment="Left" VerticalAlignment="Center"
                  Grid.Row="0" Grid.Column="0"
                />
                <parts:TimerViewer
                  Timer="{Binding BottomGameTime}"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Grid.Row="0" Grid.Column="2"
                />
              </Grid>
              <parts:Playback DataContext="{Binding PlaybackViewModel}"/>
            </StackPanel>
</UserControl>
